port: 8080

secret_key: go-zoox

session_max_age: 86400

frontend:
  host: 127.0.0.1
  port: 8000

backend:
  host: 127.0.0.1
  port: 8001

oauth2:
  - name: doreamon
    client_id: <CLIENT_ID>
    client_secret: <CLIENT_SECRET>
    redirect_uri: http://127.0.0.1:8080/login/doreamon/callback

password:
  mode: local # service | local, default: local
  local:
    - username: admin
      password: admin
  service: https://api.example.com  # POST

auth:
  mode: oauth2        # password | oauth2, default: oauth2
  provider: doreamon  # default: doreamon

services:
  app:
    mode: service     # service | local, default: service
    local:
      name: Lighthouse DNS
      logo: https://avatars.githubusercontent.com/u/7463687?v=4
      description: 轻量级 DNS 服务
    service: https://api.example.com/oauth/app

  user:
    mode: service     # service | local, default: service
    local:
      id: '0x01'
      username: admin
      nickname: 管理员
      avatar: https://avatars.githubusercontent.com/u/7463687?v=4
      permissions:
        - /s/dns
        - /s/docker

    service: https://api.example.com/user # GET

  menus:
    mode: service     # service | local, default: service
    local:
      - name: Home
        path: /i
        icon: appstore
      - name: DNS 管理
        path: /i/dns
        icon: appstore
        layout: header
    service: https://api.example.com/menus # GET

  users:
    mode: service
    service: https://api.example.com/users # GET

  open_id:
    mode: service
    service: https://api.example.com/oauth/app/user/open_id # GET

# Built-in admin UI (JSON APIs + embedded static). When enabled, the UI is served under admin.entry (default /admin).
admin:
  enabled: false
  entry: /admin   # URL prefix for embedded admin UI (no trailing slash); only active when enabled: true
  auth:
    admin:
      username: root
      password: change-me
  database:
    driver: sqlite
    dsn: file:admin.db?cache=shared

routes:
  - path: /api/ms/httpbin
    backend:
      serviceProtocol: https
      serviceName: httpbin.zcorky.com
      servicePort: 443
